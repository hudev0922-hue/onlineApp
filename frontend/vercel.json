{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_RAILWAY_BACKEND_URL/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://REPLACE_WITH_RAILWAY_BACKEND_URL/storage/:path*"
    },
    {
      "source": "/((?!api|storage).*)",
      "destination": "/index.html"
    }
  ]
}
